# 0/1 knapsack DP: dp[i][w] = best value using the first i items at capacity w.

extends Node

func knapsack(weights: Array[int], values: Array[int], capacity: int) -> int:
	var n := weights.size()
	var dp: Array = []
	var i := 0
	while i <= n:
		var row: Array[int] = []
		var w := 0
		while w <= capacity:
			row.append(0)
			w += 1
		dp.append(row)
		i += 1

	var item := 1
	while item <= n:
		var weight := weights[item - 1]
		var value := values[item - 1]
		var w := 0
		while w <= capacity:
			dp[item][w] = dp[item - 1][w]
			# Take the item only when it fits this capacity.
			if weight <= w:
				var with_item: int = dp[item - 1][w - weight] + value
				if with_item > dp[item][w]:
					dp[item][w] = with_item
			w += 1
		item += 1
	return dp[n][capacity]

func _ready() -> void:
	var weights: Array[int] = [2, 3, 4, 5]
	var values: Array[int] = [3, 4, 5, 6]
	print("best value at capacity 5:", knapsack(weights, values, 5))
