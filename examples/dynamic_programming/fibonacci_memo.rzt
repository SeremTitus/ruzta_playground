# Memoized recursion: cache results so fib runs in linear time.

extends Node

var memo: Dictionary = {}

func fib(n: int) -> int:
	if n <= 1:
		return n
	# Reuse cached results instead of recomputing.
	if memo.has(n):
		return memo[n]
	var value := fib(n - 1) + fib(n - 2)
	memo[n] = value
	return value

func _ready() -> void:
	print("fib(10) =", fib(10))
	print("fib(30) =", fib(30))
