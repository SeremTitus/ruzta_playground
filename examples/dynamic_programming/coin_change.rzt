# DP coin change: dp[x] = fewest coins needed to make amount x.

extends Node

func min_coins(coins: Array[int], amount: int) -> int:
	var impossible := amount + 1
	var dp: Array[int] = []
	var i := 0
	while i <= amount:
		dp.append(impossible)
		i += 1
	dp[0] = 0

	# Relax every reachable amount with this coin.
	for coin: int in coins:
		if coin <= 0:
			continue
		var money := coin
		while money <= amount:
			var previous := dp[money - coin] + 1
			if previous < dp[money]:
				dp[money] = previous
			money += coin

	if dp[amount] > amount:
		return -1
	return dp[amount]

func _ready() -> void:
	var coins: Array[int] = [1, 3, 4]
	print("amount 6 needs", min_coins(coins, 6), "coins")
	print("amount 11 needs", min_coins(coins, 11), "coins")
