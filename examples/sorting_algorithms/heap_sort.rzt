# Heap sort: build a max-heap, then move the largest item to the end repeatedly.

extends Node

func heapify(arr: Array[int], n: int, root: int) -> void:
	var largest := root
	var left := 2 * root + 1
	var right := 2 * root + 2
	if left < n and arr[left] > arr[largest]:
		largest = left
	if right < n and arr[right] > arr[largest]:
		largest = right
	if largest != root:
		var tmp := arr[root]
		arr[root] = arr[largest]
		arr[largest] = tmp
		heapify(arr, n, largest)

func heap_sort(arr: Array[int]) -> void:
	var n := arr.size()
	var i := n / 2 - 1
	# Build a max-heap from the array.
	while i >= 0:
		heapify(arr, n, i)
		i -= 1
	# Repeatedly swap the max to the end and restore the heap.
	i = n - 1
	while i > 0:
		var tmp := arr[0]
		arr[0] = arr[i]
		arr[i] = tmp
		heapify(arr, i, 0)
		i -= 1

func _ready() -> void:
	var values: Array[int] = [12, 11, 13, 5, 6, 7]
	heap_sort(values)
	print("heap sort:", values)
