# What Ruzta adds over GDScript: tuple types, traits and @generic classes.
extends Node

tuple Vec2(x: float, y: float)

trait Damageable:
	func take_damage(amount: int) -> void

@generic(T)
class Wrapper:
	var value: T

	func _init(v: T):
		value = v

func _ready() -> void:
	var point := Vec2(3.0, 4.0)
	print("tuple:", point.x, point.y)
	var wrapped := Wrapper<String>.new("gel")
	print("generic:", wrapped.value)
