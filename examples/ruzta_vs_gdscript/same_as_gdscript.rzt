# What stays the same: this reads exactly like GDScript (@export, plain method).
# class_name Door  # global names are not supported in the playground
extends Node2D

@export var is_open := false

func toggle() -> void:
	is_open = not is_open

func _ready() -> void:
	print("open:", is_open)
	toggle()
	print("after toggle:", is_open)
