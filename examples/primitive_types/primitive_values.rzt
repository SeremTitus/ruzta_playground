# Primitive value types: int, float, String, StringName, NodePath and Vector2.
extends Node

var retries: int = 3
var cooldown: float = 0.35
var label: String = "Ruzta"
var enemy_name: StringName = &"Enemy"
var camera_path: NodePath = ^"Player/Camera2D"
var position_2d := Vector2(16, 32)

func _ready() -> void:
	print("retries:", retries, " cooldown:", cooldown)
	print("label:", label, " enemy:", enemy_name, " typeof:", typeof(enemy_name))
	print("camera:", camera_path, " position:", position_2d)
